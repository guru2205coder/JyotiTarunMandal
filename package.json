{
  "name": "jyoti-mandal-vargani-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "vercel-build": "npm --prefix frontend install --include=dev && npm --prefix frontend run build",
    "build": "npm --prefix frontend install --include=dev && npm --prefix frontend run build",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm --prefix backend start",
    "test:workflow": "node test_workflow.js",
    "test:backend": "npm --prefix backend test",
    "db:reset": "npm --prefix backend run db:reset"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
